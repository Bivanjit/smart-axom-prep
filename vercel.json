{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "smart-axom-prep.vercel.app"
        }
      ],
      "destination": "https://smartprep-axom.pages.dev/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/).*)",
      "destination": "/"
    }
  ]
}