{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "destination": "https://smartprep-axom.pages.dev/",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "smart-axom-prep.vercel.app"
        }
      ]
    },
    {
      "source": "/:path*",
      "destination": "https://smartprep-axom.pages.dev/:path*",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "smart-axom-prep.vercel.app"
        }
      ]
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
