{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "smart-axom-prep.vercel.app"
        }
      ],
      "missing": [
        {
          "type": "header",
          "key": "x-forwarded-host"
        }
      ],
      "destination": "https://smartprep-axom.pages.dev/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|sitemap\\.xml$|robots\\.txt$|favicon|site\\.webmanifest$|brand-banner\\.svg$|apple-touch-icon|google93fc950b690c4e5d\\.html$).*)",
      "destination": "/"
    }
  ]
}